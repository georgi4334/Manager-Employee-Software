  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, categoryId])
  @@map("skill")
}

model EmployeeSkill {
  id                   String   @id @default(uuid(7)) @db.Uuid
  tenantId             String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  employeeId           String   @map("employee_id") @db.Uuid
  skillId              String   @map("skill_id") @db.Uuid
  /// 1 (beginner) to 5 (expert)
  level                Int
  /// Who set the level last; the employee themself for a self-assessment.
  assessedByEmployeeId String?  @map("assessed_by_employee_id") @db.Uuid
  assessedAt           DateTime @default(now()) @map("assessed_at") @db.Timestamptz(6)

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee   Employee  @relation("SkillOwner", fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)
  skill      Skill     @relation(fields: [tenantId, skillId], references: [tenantId, id], onDelete: NoAction)
  assessedBy Employee? @relation("SkillAssessor", fields: [tenantId, assessedByEmployeeId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, employeeId, skillId])
  @@index([tenantId, skillId, level])
  @@map("employee_skill")
}

// ----- Performance reviews (docs/adr/0023-performance-reviews.md) ---------------------------------------

model ReviewCycle {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  name        String
  periodStart DateTime  @map("period_start") @db.Date
  periodEnd   DateTime  @map("period_end") @db.Date
  selfDue     DateTime  @map("self_due") @db.Date
  managerDue  DateTime  @map("manager_due") @db.Date
  /// draft | open | calibration | closed (only forward)
  status      String    @default("draft")
  openedAt    DateTime? @map("opened_at") @db.Timestamptz(6)
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competencies ReviewCompetency[]
  reviews      Review[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("review_cycle")
}

model ReviewCompetency {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  cycleId     String   @map("cycle_id") @db.Uuid
  name        String
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycle   ReviewCycle    @relation(fields: [tenantId, cycleId], references: [tenantId, id], onDelete: Cascade)
  ratings ReviewRating[]

  @@unique([tenantId, id])
  @@index([tenantId, cycleId])
  @@map("review_competency")
}

model Review {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  cycleId            String    @map("cycle_id") @db.Uuid
  employeeId         String    @map("employee_id") @db.Uuid
  selfSummary        String?   @map("self_summary")
  selfSubmittedAt    DateTime? @map("self_submitted_at") @db.Timestamptz(6)
  managerSummary     String?   @map("manager_summary")
  /// The manager's overall rating, 1-5.
  overallRating      Int?      @map("overall_rating")
  managerSubmittedAt DateTime? @map("manager_submitted_at") @db.Timestamptz(6)
  managerAuthorId    String?   @map("manager_author_id") @db.Uuid
  /// HR's rating after calibration, 1-5; the final rating is this, else the overall rating.
  calibratedRating   Int?      @map("calibrated_rating")
  releasedAt         DateTime? @map("released_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycle         ReviewCycle    @relation(fields: [tenantId, cycleId], references: [tenantId, id], onDelete: Cascade)
  employee      Employee       @relation("ReviewSubject", fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)
  managerAuthor Employee?      @relation("ReviewAuthor", fields: [tenantId, managerAuthorId], references: [tenantId, id], onDelete: NoAction)
  ratings       ReviewRating[]

  @@unique([tenantId, id])
  @@unique([tenantId, cycleId, employeeId])
  @@index([tenantId, employeeId])
  @@map("review")
}

model ReviewRating {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  reviewId     String   @map("review_id") @db.Uuid
  competencyId String   @map("competency_id") @db.Uuid
  /// self | manager
  part         String
  score        Int
  comment      String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  review     Review           @relation(fields: [tenantId, reviewId], references: [tenantId, id], onDelete: Cascade)
  competency ReviewCompetency @relation(fields: [tenantId, competencyId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, reviewId, competencyId, part])
  @@map("review_rating")
}

// ----- AI assistant (docs/adr/0025-ai-assistant.md) ------------------------------------------------------

/// One row per workspace; AI is off until an administrator switches it on.
model AiWorkspaceSetting {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  enabled       Boolean  @default(false)
  retentionDays Int      @default(90) @map("retention_days")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId])
  @@unique([tenantId, id])
  @@map("ai_workspace_setting")
}

/// A provider key, encrypted at rest (AES-256-GCM). Never returned by the API; only `last4` is shown.
model AiCredential {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  /// user | workspace
  scope      String
  /// Set exactly for scope "user" (a check constraint in the migration).
  userId     String?  @map("user_id") @db.Uuid
  provider   String
  model      String
  /// base64(iv) "." base64(tag) "." base64(ciphertext)
  secretEnc  String   @map("secret_enc")
  keyVersion Int      @default(1) @map("key_version")
  last4      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@map("ai_credential")
}

/// The consent record and the choice to let the assistant look up other people.
model AiUserSetting {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  consentAt       DateTime? @map("consent_at") @db.Timestamptz(6)
  consentVersion  Int?      @map("consent_version")
  sharePeopleData Boolean   @default(false) @map("share_people_data")
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@map("ai_user_setting")
}

model AiConversation {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  messages AiMessage[]

  @@unique([tenantId, id])
  @@index([tenantId, userId, updatedAt])
  @@map("ai_conversation")
}

/// Only the visible turns are kept (the question and the final answer), never tool results.
model AiMessage {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  /// For the hourly limit.
  userId         String   @map("user_id") @db.Uuid
  /// user | assistant
  role           String
  content        String
  toolsUsed      String[] @default([]) @map("tools_used")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  conversation AiConversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, userId, role, createdAt])
  @@map("ai_message")
}
