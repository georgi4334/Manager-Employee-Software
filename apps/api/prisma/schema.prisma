// ----- Clients and projects (docs/adr/0013-clients-and-projects.md) -------------------------------------

model Client {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  /// Unique per workspace, case-insensitive (a functional index in the migration).
  name         String
  contactName  String?  @map("contact_name")
  contactEmail String?  @map("contact_email")
  notes        String?
  /// active | archived
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projects Project[]

  @@unique([tenantId, id])
  @@map("client")
}

model Project {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  /// Upper-case letters, digits and dashes; unique per workspace.
  code           String
  name           String
  description    String?
  clientId       String?   @map("client_id") @db.Uuid
  /// planned | active | paused | done
  status         String    @default("planned")
  /// low | normal | high
  priority       String    @default("normal")
  isBillable     Boolean   @default(true) @map("is_billable")
  budgetHours    Decimal?  @map("budget_hours") @db.Decimal(9, 1)
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  leadEmployeeId String?   @map("lead_employee_id") @db.Uuid
  /// Counter for the task numbers of this project (docs/adr/0014-tasks.md).
  taskSeq        Int       @default(0) @map("task_seq")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client?             @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: NoAction)
  lead        Employee?           @relation("ProjectLead", fields: [tenantId, leadEmployeeId], references: [tenantId, id], onDelete: NoAction)
  milestones  Milestone[]
  assignments ProjectAssignment[]
  tasks       Task[]
  timeEntries TimeEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, clientId])
  @@index([tenantId, leadEmployeeId])
  @@index([tenantId, status])
  @@map("project")
}

model Milestone {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  title     String
