generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String
  slug            String   @unique
  defaultLocale   String   @default("en") @map("default_locale")
  defaultTimezone String   @default("Europe/Sofia") @map("default_timezone")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users     User[]
  roles     Role[]
  auditLogs AuditLog[]

  @@map("tenant")
}

// ---------------------------------------------------------------------------------------------
// Authentication (docs/adr/0002-authentication.md). Every table is tenant-scoped with RLS.

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  /// Lower-cased and trimmed; unique per tenant.
  email           String
  status          String    @default("invited")
  locale          String?
  timezone        String?
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  identities AuthIdentity[]
  sessions   Session[]
  tokens     AuthToken[]
  roles      UserRole[]

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([email])
  @@map("app_user")
}

model AuthIdentity {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  /// "password" or "google"
  provider        String
  /// Google "sub"; the user id for password identities.
  providerSubject String   @map("provider_subject")
  passwordHash    String?  @map("password_hash")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, provider, providerSubject])
  @@unique([userId, provider])
  @@map("auth_identity")
}

model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// "password" or "google"
  method    String
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User           @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@unique([tenantId, id])
  @@index([userId])
  @@map("session")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// SHA-256 of the raw token (hex); the raw token exists only in the browser cookie.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_token")
}

/// One-time links: invitations and password resets.
model AuthToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// "invite" or "password_reset"
  purpose   String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_token")
}

// ---------------------------------------------------------------------------------------------
// Roles and permissions (docs/adr/0003-roles-and-permissions.md). The permission catalog lives in
// @intime/contracts; these tables store roles, their grants and who holds them.

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  /// admin | hr | manager | employee for system roles; null for custom roles.
  key         String?
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@unique([tenantId, name])
  @@map("role")
}

model RolePermission {
  tenantId       String @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  /// A code from the catalog in @intime/contracts; validated when written and when read.
  permissionCode String @map("permission_code")
  /// own | reports | team | department | all
  scope          String

  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@map("role_permission")
}

model UserRole {
  tenantId  String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: NoAction)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

/// Append-only (UPDATE is revoked from both runtime roles): who did what, when.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  /// Pseudonymous reference without a foreign key, so erasing a user never rewrites history.
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entity      String
  entityId    String?  @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("audit_log")
}
