generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String
  slug            String   @unique
  defaultLocale   String   @default("en") @map("default_locale")
  defaultTimezone String   @default("Europe/Sofia") @map("default_timezone")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users                   User[]
  roles                   Role[]
  auditLogs               AuditLog[]
  outboxEvents            OutboxEvent[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  employees               Employee[]
  departments             Department[]
  teams                   Team[]
  teamMembers             TeamMember[]
  leaveTypes              LeaveType[]
  holidays                Holiday[]
  leaveSettings           LeaveSettings?
  attendanceRecords       AttendanceRecord[]
  calendarEvents          CalendarEvent[]
  clients                 Client[]
  projects                Project[]
  milestones              Milestone[]
  projectAssignments      ProjectAssignment[]
  tasks                   Task[]
  leavePolicies           LeavePolicy[]
  leaveBalances           LeaveBalance[]
  leaveRequests           LeaveRequest[]
  leaveRequestDays        LeaveRequestDay[]
  leaveApprovals          LeaveApproval[]

  @@map("tenant")
}

// ---------------------------------------------------------------------------------------------
// Authentication (docs/adr/0002-authentication.md). Every table is tenant-scoped with RLS.

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  /// Lower-cased and trimmed; unique per tenant.
  email           String
  status          String    @default("invited")
  locale          String?
  timezone        String?
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  identities              AuthIdentity[]
  sessions                Session[]
  tokens                  AuthToken[]
  roles                   UserRole[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  employee                Employee?

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([email])
  @@map("app_user")
}

model AuthIdentity {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  /// "password" or "google"
  provider        String
  /// Google "sub"; the user id for password identities.
  providerSubject String   @map("provider_subject")
  passwordHash    String?  @map("password_hash")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, provider, providerSubject])
  @@unique([userId, provider])
  @@map("auth_identity")
}

model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// "password" or "google"
  method    String
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User           @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@unique([tenantId, id])
  @@index([userId])
  @@map("session")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// SHA-256 of the raw token (hex); the raw token exists only in the browser cookie.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_token")
}

/// One-time links: invitations and password resets.
model AuthToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// "invite" or "password_reset"
  purpose   String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_token")
}

// ---------------------------------------------------------------------------------------------
// Roles and permissions (docs/adr/0003-roles-and-permissions.md). The permission catalog lives in
// @intime/contracts; these tables store roles, their grants and who holds them.

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  /// admin | hr | manager | employee for system roles; null for custom roles.
  key         String?
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@unique([tenantId, name])
  @@map("role")
}

model RolePermission {
  tenantId       String @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  /// A code from the catalog in @intime/contracts; validated when written and when read.
  permissionCode String @map("permission_code")
  /// own | reports | team | department | all
  scope          String

  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@map("role_permission")
}

model UserRole {
  tenantId  String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: NoAction)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

/// Append-only (UPDATE is revoked from both runtime roles): who did what, when.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  /// Pseudonymous reference without a foreign key, so erasing a user never rewrites history.
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entity      String
  entityId    String?  @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------------------------
// Notifications (docs/adr/0004-notifications.md)

/// Event log and job queue in one: written in the same transaction as the change, processed by the worker.
model OutboxEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  type        String
  /// Ids and short non-sensitive labels only.
  params      Json      @default("{}")
  /// pending | processing | done | dead
  status      String    @default("pending")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@map("outbox_event")
}

/// One row per person per event: the in-app inbox entry and, at the same time, the email queue.
model Notification {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  /// The outbox event that produced it; with the recipient it makes processing idempotent.
  eventId         String?   @map("event_id") @db.Uuid
  type            String
  params          Json      @default("{}")
  link            String
  /// Shown in the inbox? (false when the person only wants the email)
  inApp           Boolean   @default(true) @map("in_app")
  readAt          DateTime? @map("read_at") @db.Timestamptz(6)
  /// none | pending | sending | sent | failed | skipped
  emailStatus     String    @default("none") @map("email_status")
  emailAttempts   Int       @default(0) @map("email_attempts")
  emailNextAt     DateTime? @map("email_next_at") @db.Timestamptz(6)
  emailSentAt     DateTime? @map("email_sent_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient User   @relation(fields: [tenantId, recipientUserId], references: [tenantId, id], onDelete: Cascade)

  @@unique([eventId, recipientUserId])
  @@index([recipientUserId, id])
  @@index([emailStatus, emailNextAt])
  @@map("notification")
}

model NotificationPreference {
  tenantId  String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  /// in_app | email
  channel   String
  enabled   Boolean
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@id([userId, type, channel])
  @@map("notification_preference")
}

/// A person who works at the company (docs/adr/0006-employees.md). Separate from the login account: the
/// account may not exist yet or may be disabled while this record is kept.
model Employee {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  userId          String?   @map("user_id") @db.Uuid
  employeeNo      String?   @map("employee_no")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  jobTitle        String?   @map("job_title")
  location        String?
  /// full_time | part_time | contractor | outsourced
  employmentType  String    @default("full_time") @map("employment_type")
  /// intern | junior | mid | senior | lead | principal
  seniority       String?
  hireDate        DateTime? @map("hire_date") @db.Date
  terminationDate DateTime? @map("termination_date") @db.Date
  birthDate       DateTime? @map("birth_date") @db.Date
  phone           String?
  /// ISO 3166-1 alpha-2
  country         String?
  /// active | inactive
  status          String    @default("active")
  /// Set when the personal data was erased (docs/adr/0011-gdpr-export-erasure.md); irreversible.
  erasedAt        DateTime? @map("erased_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// docs/adr/0007-organization.md
  departmentId String? @map("department_id") @db.Uuid
  managerId    String? @map("manager_id") @db.Uuid

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User?               @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: NoAction)
  department         Department?         @relation("EmployeeDepartment", fields: [tenantId, departmentId], references: [tenantId, id], onDelete: NoAction)
  manager            Employee?           @relation("Reporting", fields: [tenantId, managerId], references: [tenantId, id], onDelete: NoAction)
  reports            Employee[]          @relation("Reporting")
  headedDepartments  Department[]        @relation("DepartmentHead")
  ledTeams           Team[]              @relation("TeamLead")
  teamMemberships    TeamMember[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  leaveApprovals     LeaveApproval[]
  attendanceRecords  AttendanceRecord[]
  calendarEvents     CalendarEvent[]
  ledProjects        Project[]           @relation("ProjectLead")
  projectAssignments ProjectAssignment[]
  tasksAssigned      Task[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@unique([tenantId, employeeNo])
  @@index([tenantId, managerId])
  @@index([tenantId, departmentId])
  @@index([tenantId, lastName, firstName])
  @@map("employee")
}

/// A department; departments form a tree (docs/adr/0007-organization.md). Names are unique per workspace
/// (case-insensitive, a functional index in the migration).
model Department {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  name           String
  parentId       String?  @map("parent_id") @db.Uuid
  headEmployeeId String?  @map("head_employee_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Department?  @relation("DepartmentTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: NoAction)
  children  Department[] @relation("DepartmentTree")
  head      Employee?    @relation("DepartmentHead", fields: [tenantId, headEmployeeId], references: [tenantId, id], onDelete: NoAction)
  employees Employee[]   @relation("EmployeeDepartment")
  teams     Team[]

  @@unique([tenantId, id])
  @@index([tenantId, parentId])
  @@map("department")
}

/// A team inside a department. Teams group people; they grant no access.
model Team {
  calendarEvents CalendarEvent[]
  id             String          @id @default(uuid(7)) @db.Uuid
  tenantId       String          @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  name           String
  departmentId   String          @map("department_id") @db.Uuid
  leadEmployeeId String?         @map("lead_employee_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department   @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: NoAction)
  lead       Employee?    @relation("TeamLead", fields: [tenantId, leadEmployeeId], references: [tenantId, id], onDelete: NoAction)
  members    TeamMember[]

  @@unique([tenantId, id])
  @@index([tenantId, departmentId])
  @@map("team")
}

model TeamMember {
  tenantId   String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team     Team     @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Cascade)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: NoAction)

  @@id([teamId, employeeId])
  @@index([tenantId, employeeId])
  @@map("team_member")
}

// ----- Leave (docs/adr/0008-leave.md) -----------------------------------------------------------------

/// System types have a key (translated by the client) and no name; custom types have a name and no key.
model LeaveType {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  key              String?
  name             String?
  tracksBalance    Boolean  @default(false) @map("tracks_balance")
  requiresApproval Boolean  @default(true) @map("requires_approval")
  isSick           Boolean  @default(false) @map("is_sick")
  /// A design-token colour name, never a hex value.
  color            String   @default("primary")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy   LeavePolicy?
  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("leave_type")
}

model LeavePolicy {
  id                  String   @id @default(uuid(7)) @db.Uuid
  tenantId            String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  leaveTypeId         String   @map("leave_type_id") @db.Uuid
  annualAllowanceDays Decimal  @map("annual_allowance_days") @db.Decimal(5, 1)
  carryOverMaxDays    Decimal  @default(0) @map("carry_over_max_days") @db.Decimal(5, 1)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [tenantId, leaveTypeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, leaveTypeId])
  @@map("leave_policy")
}

/// Created lazily the first time it is needed, then frozen. Used and pending days are never stored: they are
/// sums over leave_request_day.
model LeaveBalance {
  tenantId    String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  leaveTypeId String   @map("leave_type_id") @db.Uuid
  year        Int
  entitled    Decimal  @db.Decimal(5, 1)
  carriedOver Decimal  @default(0) @map("carried_over") @db.Decimal(5, 1)
  adjustment  Decimal  @default(0) @db.Decimal(5, 1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: NoAction)
  leaveType LeaveType @relation(fields: [tenantId, leaveTypeId], references: [tenantId, id], onDelete: NoAction)

  @@id([employeeId, leaveTypeId, year])
  @@index([tenantId, employeeId])
  @@map("leave_balance")
}

model LeaveRequest {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  leaveTypeId  String    @map("leave_type_id") @db.Uuid
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime  @map("end_date") @db.Date
  halfDayStart Boolean   @default(false) @map("half_day_start")
  halfDayEnd   Boolean   @default(false) @map("half_day_end")
  days         Decimal   @db.Decimal(4, 1)
  /// Never stored for sick types.
  reason       String?
  /// pending | approved | rejected | cancelled
  status       String    @default("pending")
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee  Employee          @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: NoAction)
  leaveType LeaveType         @relation(fields: [tenantId, leaveTypeId], references: [tenantId, id], onDelete: NoAction)
  daysList  LeaveRequestDay[]
  approvals LeaveApproval[]

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, startDate])
  @@index([tenantId, status, startDate])
  @@map("leave_request")
}

/// The counted working days of a request, stored when it is made (later holiday edits never change them).
model LeaveRequestDay {
  tenantId  String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  day       DateTime @db.Date
  fraction  Decimal  @db.Decimal(2, 1)

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request LeaveRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Cascade)

  @@id([requestId, day])
  @@index([tenantId, day])
  @@map("leave_request_day")
}

/// Append-only record of decisions.
model LeaveApproval {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  requestId          String   @map("request_id") @db.Uuid
  approverEmployeeId String   @map("approver_employee_id") @db.Uuid
  /// approved | rejected | cancelled
  decision           String
  comment            String?
  decidedAt          DateTime @default(now()) @map("decided_at") @db.Timestamptz(6)

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request  LeaveRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Cascade)
  approver Employee     @relation(fields: [tenantId, approverEmployeeId], references: [tenantId, id], onDelete: NoAction)

  @@index([tenantId, requestId])
  @@map("leave_approval")
}

/// Custom public or company holidays; the Bulgarian and German national days are computed in code.
model Holiday {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  date      DateTime @db.Date
  name      String
  /// ISO 3166-1 alpha-2; null = every employee
  country   String?
  isHalfDay Boolean  @default(false) @map("is_half_day")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@map("holiday")
}

model LeaveSettings {
  tenantId             String   @id @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  hideSickTypeFromTeam Boolean  @default(false) @map("hide_sick_type_from_team")
  defaultCountry       String?  @map("default_country")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("leave_settings")
}

// ----- Attendance (docs/adr/0009-attendance.md) -------------------------------------------------------

/// Self-reported working time: no location, no IP, no device. One open record per employee, no overlaps.
model AttendanceRecord {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  /// The date of the check-in in the workspace time zone.
  workDate   DateTime  @map("work_date") @db.Date
  checkInAt  DateTime  @map("check_in_at") @db.Timestamptz(6)
  checkOutAt DateTime? @map("check_out_at") @db.Timestamptz(6)
  /// office | remote | field
  mode       String
  note       String?
  /// clock | entry | correction
  source     String    @default("clock")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, workDate])
  @@index([tenantId, workDate])
  @@map("attendance_record")
}

// ----- Calendar (docs/adr/0010-calendar.md) -------------------------------------------------------------

model CalendarEvent {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  /// personal | team | company
  scope           String
  /// The creator; for personal events the only person who sees it.
  ownerEmployeeId String    @map("owner_employee_id") @db.Uuid
  teamId          String?   @map("team_id") @db.Uuid
  title           String
  description     String?
  location        String?
  allDay          Boolean   @map("all_day")
  /// Local dates in the workspace time zone, always set; the end is inclusive.
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime  @map("end_date") @db.Date
  /// Instants, only for timed events.
  startsAt        DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime? @map("ends_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner  Employee @relation(fields: [tenantId, ownerEmployeeId], references: [tenantId, id], onDelete: NoAction)
  team   Team?    @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, startDate, endDate])
  @@index([tenantId, ownerEmployeeId])
  @@index([tenantId, teamId])
  @@map("calendar_event")
}

// ----- Clients and projects (docs/adr/0013-clients-and-projects.md) -------------------------------------

model Client {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  /// Unique per workspace, case-insensitive (a functional index in the migration).
  name         String
  contactName  String?  @map("contact_name")
  contactEmail String?  @map("contact_email")
  notes        String?
  /// active | archived
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projects Project[]

  @@unique([tenantId, id])
  @@map("client")
}

model Project {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  /// Upper-case letters, digits and dashes; unique per workspace.
  code           String
  name           String
  description    String?
  clientId       String?   @map("client_id") @db.Uuid
  /// planned | active | paused | done
  status         String    @default("planned")
  /// low | normal | high
  priority       String    @default("normal")
  isBillable     Boolean   @default(true) @map("is_billable")
  budgetHours    Decimal?  @map("budget_hours") @db.Decimal(9, 1)
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  leadEmployeeId String?   @map("lead_employee_id") @db.Uuid
  /// Counter for the task numbers of this project (docs/adr/0014-tasks.md).
  taskSeq        Int       @default(0) @map("task_seq")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client?             @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: NoAction)
  lead        Employee?           @relation("ProjectLead", fields: [tenantId, leadEmployeeId], references: [tenantId, id], onDelete: NoAction)
  milestones  Milestone[]
  assignments ProjectAssignment[]
  tasks       Task[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, clientId])
  @@index([tenantId, leadEmployeeId])
  @@index([tenantId, status])
  @@map("project")
}

model Milestone {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  title     String
  dueDate   DateTime  @map("due_date") @db.Date
  /// open | done
  status    String    @default("open")
  doneOn    DateTime? @map("done_on") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  tasks   Task[]

  @@unique([tenantId, id])
  @@index([tenantId, projectId, dueDate])
  @@map("milestone")
}

model ProjectAssignment {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  role          String?
  allocationPct Int       @map("allocation_pct")
  fromDate      DateTime  @map("from_date") @db.Date
  /// null = open end
  toDate        DateTime? @map("to_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, projectId])
  @@index([tenantId, employeeId, fromDate])
  @@map("project_assignment")
}

// ----- Tasks (docs/adr/0014-tasks.md) -------------------------------------------------------------------

model Task {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  projectId          String    @map("project_id") @db.Uuid
  /// 1, 2, 3 ... inside the project; the reference is CODE-number.
  number             Int
  /// Must belong to the same project (a trigger in the migration checks it).
  milestoneId        String?   @map("milestone_id") @db.Uuid
  title              String
  description        String?
  /// functional | non_functional
  type               String    @default("functional")
  /// todo | in_progress | review | done
  status             String    @default("todo")
  /// low | normal | high
  priority           String    @default("normal")
  assigneeEmployeeId String?   @map("assignee_employee_id") @db.Uuid
  estimateHours      Decimal?  @map("estimate_hours") @db.Decimal(6, 1)
  dueDate            DateTime? @map("due_date") @db.Date
  doneOn             DateTime? @map("done_on") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project    @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [tenantId, milestoneId], references: [tenantId, id], onDelete: NoAction)
  assignee  Employee?  @relation(fields: [tenantId, assigneeEmployeeId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, number])
  @@index([tenantId, projectId, status])
  @@index([tenantId, assigneeEmployeeId])
  @@index([tenantId, milestoneId])
  @@map("task")
}
