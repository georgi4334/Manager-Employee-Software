  /// timer | manual
  source     String
  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  endedAt    DateTime? @map("ended_at") @db.Timestamptz(6)
  /// Set when the reminder about a timer left running was sent (once).
  remindedAt DateTime? @map("reminded_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: NoAction)
  project  Project  @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: NoAction)
  task     Task?    @relation(fields: [tenantId, taskId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, workDate])
  @@index([tenantId, projectId, workDate])
  @@index([tenantId, taskId])
  @@map("time_entry")
}

model Timesheet {
  id                  String    @id @default(uuid(7)) @db.Uuid
  tenantId            String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
