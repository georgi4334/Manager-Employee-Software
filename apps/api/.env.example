# Copy to .env for local development (never commit .env). Roles: docs/adr/0001-multi-tenancy-rls.md
NODE_ENV=development
PORT=3000
# Runtime connection: restricted role, Row Level Security limits it to the current tenant
DATABASE_URL=postgresql://intime_app:intime_app@localhost:5432/intime
# Cross-tenant operations only (provisioning, login, jobs)
SYSTEM_DATABASE_URL=postgresql://intime_system:intime_system@localhost:5432/intime
# Table owner, used only by `prisma migrate` (never by the running API)
MIGRATION_DATABASE_URL=postgresql://intime:intime@localhost:5432/intime
# Integration tests: a role that may create roles and run migrations (the API tests derive the others)
TEST_DATABASE_URL=postgresql://intime:intime@localhost:5432/intime_test
# --- Authentication (docs/adr/0002-authentication.md)
# The web app: links in emails, redirect after Google sign-in, allowed origin for writes
WEB_APP_URL=http://localhost:5173
# Signs access tokens; at least 32 characters. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
# Optional overrides: ACCESS_TOKEN_TTL_SECONDS=900 REFRESH_TOKEN_TTL_DAYS=14 SESSION_MAX_DAYS=30
# log = print emails incl. links (development only) · memory = tests · disabled = drop (allowed in production until step 8)
MAIL_TRANSPORT=log
# Optional Google sign-in (all three or none). Redirect URL: <api>/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=http://localhost:3000/api/v1/auth/google/callback
# Production defaults: COOKIE_SECURE=true, TRUST_PROXY=true (one proxy hop, e.g. the hosting load balancer)

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
# Interactive docs at /api/docs (default: on, except in production)
SWAGGER_ENABLED=true
