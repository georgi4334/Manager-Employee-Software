# Copy to .env for local development (never commit .env).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://intime:intime@localhost:5432/intime
# Used only by the database integration tests (apps/api/test/*.int.test.ts)
TEST_DATABASE_URL=postgresql://intime:intime@localhost:5432/intime_test
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
# Interactive docs at /api/docs (default: on, except in production)
SWAGGER_ENABLED=true
