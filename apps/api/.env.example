# Copy to .env for local development (never commit .env). Roles: docs/adr/0001-multi-tenancy-rls.md
NODE_ENV=development
PORT=3000
# Runtime connection: restricted role, Row Level Security limits it to the current tenant
DATABASE_URL=postgresql://intime_app:intime_app@localhost:5432/intime
# Cross-tenant operations only (provisioning, login, jobs)
SYSTEM_DATABASE_URL=postgresql://intime_system:intime_system@localhost:5432/intime
# Table owner, used only by `prisma migrate` (never by the running API)
MIGRATION_DATABASE_URL=postgresql://intime:intime@localhost:5432/intime
# Integration tests: a role that may create roles and run migrations (the API tests derive the others)
TEST_DATABASE_URL=postgresql://intime:intime@localhost:5432/intime_test
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
# Interactive docs at /api/docs (default: on, except in production)
SWAGGER_ENABLED=true
